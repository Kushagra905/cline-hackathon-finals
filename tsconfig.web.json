{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false
  },
  "include": ["src/web/**/*.ts", "src/web/**/*.tsx", "src/finance/money.ts", "src/finance/compare.ts", "src/finance/facts.ts", "src/shared/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
